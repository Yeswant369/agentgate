# Copy to .env for local dev. In production these are set in the Vercel dashboard.
# NEVER commit .env.

ENV=dev

# Neon: use the POOLED connection string, with the psycopg3 driver prefix.
# Neon gives you postgres://...; change the scheme to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=require

# Razorpay test-mode credentials (Phase 2) - from dashboard.razorpay.com, Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
